# Copy this file to .env and change the values.

# Port the API listens on
PORT=4000

# Password for the admin area (the website's /admin page asks for it).
# Use a long random string, at least 16 characters. Admin stays switched off if this is empty.
# To make one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Websites allowed to call the API from a browser, separated by commas.
# Not needed when the Next.js site forwards /api calls (the default setup), but harmless.
CORS_ORIGINS=http://localhost:3000

# Where news posts and enquiries are saved (a JSON file, created on first run)
DATA_FILE=data/db.json

# Set to 1 when the API sits behind a proxy or host that adds X-Forwarded-For (most hosts do)
TRUST_PROXY=0
